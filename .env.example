# Wzór konfiguracji środowiska Apki 2.0. Skopiuj do .env.production.local
# (build do publikacji) i uzupełnij danymi NOWEGO projektu Firebase.
#
# Bez tego pliku apka działa w trybie lokalnym — na emulatorach
# (`npm run lokalnie`), bez żadnego połączenia z chmurą.
#
# NIE wpisuj tu projektu aplikacja-0 — to baza starej Apki.
# Podaj KOMPLET sześciu wartości — przy niepełnym zestawie apka zostaje
# w trybie lokalnym.
#
# Opcjonalnie: VITE_USE_EMULATORS=1 wymusza emulatory nawet przy komplecie.
#
# Wartości znajdziesz w konsoli Firebase:
# Ustawienia projektu → Twoje aplikacje → Konfiguracja SDK.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
